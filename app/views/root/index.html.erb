<%# Hero %>
<section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-blue-800 via-blue-700 to-blue-600 px-6 py-14 text-center text-white shadow-xl shadow-blue-600/20 md:px-12 md:py-20">
  <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-white/10 blur-2xl"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-16 size-80 rounded-full bg-sky-300/20 blur-3xl"></div>
  <div class="relative space-y-8">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3.5 py-1.5 text-xs font-semibold tracking-wide ring-1 ring-white/30">
      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
      招待制・プライベート配信
    </span>
    <h1 class="font-logo text-5xl tracking-tight md:text-7xl">CIRCLECAST</h1>
    <p class="mx-auto max-w-xl text-lg font-medium leading-relaxed text-white md:text-2xl">
      プライベートなグループ向け<br>ポッドキャストサービス
    </p>
    <p class="mx-auto max-w-lg text-sm leading-relaxed text-blue-50 md:text-base">
      招待したメンバーだけが聴ける、クローズドな音声配信の場です。あなたのコミュニティの声を、届けたい人にだけ届けられます。
    </p>
    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <%= link_to '新規登録', new_user_registration_path, class: 'w-full sm:w-auto rounded-full bg-white px-8 py-3.5 text-sm font-bold text-blue-700 shadow-lg transition hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-white/50' %>
      <%= link_to 'ログイン', new_user_session_path, class: 'w-full sm:w-auto rounded-full bg-white/10 px-8 py-3.5 text-sm font-bold text-white ring-1 ring-white/70 transition hover:bg-white/20 focus:outline-none focus:ring-4 focus:ring-white/40' %>
    </div>
    <%# Player mock %>
    <div class="mx-auto flex max-w-md items-center gap-4 rounded-2xl bg-white/15 p-4 text-left shadow-inner ring-1 ring-white/30 backdrop-blur">
      <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-white text-blue-600 shadow">
        <svg class="ml-0.5 size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347a1.125 1.125 0 0 1 0 1.971l-11.54 6.347a1.125 1.125 0 0 1-2.779-1.643V5.653Z" clip-rule="evenodd" /></svg>
      </span>
      <div class="min-w-0 flex-1 space-y-2">
        <div class="h-2.5 w-3/4 rounded-full bg-white/70"></div>
        <div class="flex h-6 items-end gap-1" aria-hidden="true">
          <% [35, 60, 45, 80, 55, 95, 40, 70, 85, 50, 65, 30, 75, 90, 45, 60, 38, 82, 55, 68, 42, 58, 72, 33].each do |h| %>
            <span class="w-1 rounded-full bg-white/60" style="height: <%= h %>%"></span>
          <% end %>
        </div>
      </div>
      <span class="shrink-0 text-xs font-semibold text-white">12:34</span>
    </div>
  </div>
</section>

<%# About %>
<section class="mt-14 flex flex-col items-center gap-8 rounded-[2rem] bg-slate-50 px-6 py-10 md:flex-row md:gap-12 md:px-10">
  <%= image_tag 'radio_shinya_man-min.png', alt: '深夜にラジオを聴く男性', class: 'size-40 shrink-0 object-scale-down md:size-56' %>
  <div class="space-y-4">
    <p class="text-xs font-bold uppercase tracking-widest text-blue-700">About</p>
    <h2 class="text-2xl font-bold tracking-tight text-gray-900 md:text-3xl">CIRCLECASTとは？</h2>
    <p class="leading-relaxed text-gray-700">
      プライベートなグループ向けのポッドキャストサービスです。
    </p>
    <p class="leading-relaxed text-gray-700">
      企業、プログラミングスクール、趣味のサークルなど、さまざまなコミュニティで活用可能です。
    </p>
    <p class="leading-relaxed text-gray-700">
      メッセージを効果的に伝え、コミュニケーションを活性化する新しい方法です。
    </p>
  </div>
</section>

<%# Features %>
<section class="mt-14 space-y-8">
  <div class="space-y-2 text-center">
    <p class="text-xs font-bold uppercase tracking-widest text-blue-700">Features</p>
    <h2 class="text-2xl font-bold tracking-tight text-gray-900 md:text-3xl">特徴</h2>
  </div>
  <div class="grid gap-5 md:grid-cols-3">
    <div class="space-y-3 rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200/80 transition hover:shadow-md">
      <span class="flex size-11 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
      </span>
      <h3 class="font-bold text-gray-900">プライベートな空間</h3>
      <p class="text-sm leading-relaxed text-gray-700">グループは招待制です。公開したくない話も、メンバーだけのクローズドな場で安心して共有できます。</p>
    </div>
    <div class="space-y-3 rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200/80 transition hover:shadow-md">
      <span class="flex size-11 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 0 3-3V4.5a3 3 0 1 0-6 0v8.25a3 3 0 0 0 3 3Z" /></svg>
      </span>
      <h3 class="font-bold text-gray-900">番組づくりはかんたん</h3>
      <p class="text-sm leading-relaxed text-gray-700">番組やエピソードを作成し、メンバーを簡単に招待可能です。企業では社員へのメッセージ、学校やサークルでは趣味やプロジェクトに関するコンテンツを共有できます。</p>
    </div>
    <div class="space-y-3 rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200/80 transition hover:shadow-md">
      <span class="flex size-11 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>
      </span>
      <h3 class="font-bold text-gray-900">さまざまなコミュニティで</h3>
      <p class="text-sm leading-relaxed text-gray-700">企業、プログラミングスクール、趣味のサークルなど、規模やジャンルを問わず活用できます。</p>
    </div>
  </div>
  <%= image_tag 'radio_booth_talk-min.png', alt: 'ポッドキャストを収録する二人', class: 'mx-auto size-44 object-scale-down md:size-56' %>
</section>

<%# How to use %>
<section class="mt-14 space-y-8">
  <div class="space-y-2 text-center">
    <p class="text-xs font-bold uppercase tracking-widest text-blue-700">How to use</p>
    <h2 class="text-2xl font-bold tracking-tight text-gray-900 md:text-3xl">使い方</h2>
  </div>
  <ol class="grid gap-5 md:grid-cols-3">
    <li class="relative space-y-2 rounded-3xl bg-slate-50 p-6 pt-8">
      <span class="absolute -top-4 left-6 flex size-9 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white shadow">1</span>
      <h3 class="font-bold text-gray-900">グループを作成</h3>
      <p class="text-sm leading-relaxed text-gray-700">まずは、あなたのコミュニティのためのグループを作成します。</p>
    </li>
    <li class="relative space-y-2 rounded-3xl bg-slate-50 p-6 pt-8">
      <span class="absolute -top-4 left-6 flex size-9 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white shadow">2</span>
      <h3 class="font-bold text-gray-900">番組とエピソードを追加</h3>
      <p class="text-sm leading-relaxed text-gray-700">グループの中に番組を作り、エピソードをアップロードします。</p>
    </li>
    <li class="relative space-y-2 rounded-3xl bg-slate-50 p-6 pt-8">
      <span class="absolute -top-4 left-6 flex size-9 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white shadow">3</span>
      <h3 class="font-bold text-gray-900">メンバーを招待して共有</h3>
      <p class="text-sm leading-relaxed text-gray-700">グループにメンバーを招待すれば、ポッドキャストを共有できます。</p>
    </li>
  </ol>
  <%= image_tag 'radio_mail_syokunin_woman-min.png', alt: 'スマートフォンを持ってラジオを聴く女性', class: 'mx-auto size-44 object-scale-down md:size-56' %>
</section>

<%# CTA %>
<section class="mt-14 rounded-[2rem] bg-gradient-to-br from-blue-800 via-blue-700 to-blue-600 px-6 py-12 text-center text-white shadow-xl shadow-blue-600/20">
  <div class="space-y-6">
    <h2 class="text-2xl font-bold tracking-tight md:text-3xl">あなたのコミュニティの声を届けよう</h2>
    <p class="mx-auto max-w-md text-sm leading-relaxed text-blue-50 md:text-base">
      グループを作って、最初のエピソードを共有するところから始められます。
    </p>
    <%= link_to '新規登録して始める', new_user_registration_path, class: 'inline-block rounded-full bg-white px-8 py-3.5 text-sm font-bold text-blue-700 shadow-lg transition hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-white/50' %>
  </div>
</section>
